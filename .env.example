# --- required ---
ANTHROPIC_API_KEY=

# --- database (matches docker-compose.yml) ---
DATABASE_URL=postgresql://memory:memory@localhost:5434/memory

# --- models (defaults shown) ---
# CHAT_MODEL=claude-opus-5-5
# CHAT_EFFORT=low
# MEMORY_MODEL=claude-haiku-4-5

# --- memory tuning (defaults shown) ---
# RETRIEVAL_K=6
# RETRIEVAL_MIN_SIM=0.40
# RETRIEVAL_MARGIN=0.08
# EXTRACTION_MIN_DURABILITY=0.6
# CONFLICT_MIN_SIM=0.55
# DUPLICATE_SIM=0.985

# --- optional: ElevenLabs text-to-speech (browser voice is used otherwise) ---
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- optional: local Whisper speech-to-text (needs `pip install faster-whisper`) ---
# WHISPER_MODEL=base.en

# --- optional: Langfuse tracing (cloud or self-hosted) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- optional: use a standalone MCP tasks server instead of in-process ---
# MCP_SERVER_URL=http://127.0.0.1:8765/mcp
